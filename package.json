{
  "name": "wax-apiary-nexus",
  "version": "0.0.0",
  "private": true,
  "description": "WAX Apiary neXus — composable native AI harness workspace",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "complexity": "node scripts/complexity.mjs",
    "wax": "node dist/src/cli/cli.js",
    "waxd": "node dist/src/cli/waxd.js",
    "test": "node scripts/test.mjs",
    "test:integration": "npm run build && node --test \"dist/tests/integration/**/*.test.js\"",
    "test:integration:dsh": "npm run build && node --test dist/tests/integration/dsh-acp.test.js dist/tests/integration/dsh-approval-timeout.test.js dist/tests/integration/host-guard-decide.test.js dist/tests/integration/host-guard-concurrent.test.js dist/tests/integration/host-session-busy.test.js dist/tests/integration/waxd-dsh-shutdown-restart.test.js dist/tests/integration/waxd-dsh-forced-restart.test.js"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
