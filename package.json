{
  "name": "wax-hcs",
  "version": "0.0.0",
  "private": true,
  "description": "Composable Native AI Harness Workspace",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "npm run build && node dist/src/cli.js",
    "workbench": "npm run build && node dist/src/workbench-cli.js",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/tests/integration/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
